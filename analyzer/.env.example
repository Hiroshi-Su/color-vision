WS_HOST=0.0.0.0
WS_PORT=8765

# ================================================================
# ハブ転送設定 — DOモード / Tunnelモードの切り替えはURLだけで決まる
# ================================================================
# 【DOモード】ColorHub (Cloudflare Durable Object) に転送
# COLORHUB_WS_URL=wss://color-vision-worker.color-vision.workers.dev/ws
#
# 【Tunnelモード】相手拠点のanalyzer（cloudflared Tunnel公開URL）に直接転送
# COLORHUB_WS_URL=wss://<相手拠点のTunnel URL>
#
# 未設定なら外部転送なし（ローカル配信のみ）

# 送信元拠点タグ（例: tokyo / kanazawa）
# 受信側（ESP32のLISTEN_SOURCE）がどの拠点の色を表示するか選別するのに使う
# LOCATION=tokyo

# LED向け配信のレート上限（fps）。0で間引きなし（毎フレーム配信）
# DO無料枠（10万リクエスト/日）対策として10を推奨。
# LED側にフェード処理があるため10fpsでも体感は変わらない
HUB_FORWARD_FPS=10

# LED向け配信の時間帯（ローカル時刻）。例: 10-21 → 10:00〜20:59のみ配信
# "22-6" のような日またぎも可。未設定（空）なら時間制限なしで常時配信
# HUB_ACTIVE_HOURS=10-21

# LEDへ配信するモード: palette（5色帯・横一列） / matrix（低解像度映像）
LED_MODE=palette
# matrixモード時のグリッド解像度（= 設置するLEDの 横個数 × 縦個数）
MATRIX_WIDTH=16
MATRIX_HEIGHT=16

# ================================================================
# Raspberry Pi 単体構成（capture_pi.py）用の設定
# ブラウザ・ESP32を使わず、Piがカメラ撮影とLED駆動を直接行う場合のみ
# ================================================================

# --- カメラ ---
# false にするとカメラを使わない「表示専用機」になる
# （他拠点の色を受け取ってLEDに映すだけ。COLORHUB_WS_URL が必須）
CAPTURE_ENABLED=true
# auto = USBを試してから CSI にフォールバック / usb / csi
CAMERA_BACKEND=auto
CAPTURE_WIDTH=320
CAPTURE_HEIGHT=240
# 撮影・解析のレート。Pi 3 なら 5〜10、Pi 4 なら 10〜15 が目安
CAPTURE_FPS=10

# --- どの拠点の色を自分のLEDに映すか ---
# self = 自分のカメラの色（1台での動作確認用）
# any  = 他拠点から届いたものすべて
# 拠点名 = その拠点だけ（例: kanazawa → クロス表示）
LED_SOURCE=self

# --- LEDハードウェア ---
LED_COUNT=144
# データ線をつなぐGPIO番号。18(物理12番)が既定。13/19はチャンネル1側
LED_GPIO_PIN=18
# WS2812B=GRB / SK6812(RGBW)=GRBW。セルフテストで赤が赤に見えなければここを変える
LED_COLOR_ORDER=GRB
# 0〜255。USB給電なら20〜40程度に抑える
LED_BRIGHTNESS=20
# 消費電流のソフトキャップ(mA)。超えると自動減光。0で無効
LED_MAX_MILLIAMPS=400
# 色遷移の速さ 1〜255（大きいほど速い）
LED_FADE_AMOUNT=40
# LED描画の更新間隔(ms)。20=50fps。LED総数が512個を超えるなら増やす
LED_FRAME_INTERVAL_MS=20

# --- マトリクス配線（LED_MODE=matrix のとき） ---
MATRIX_SERPENTINE=true
MATRIX_VERTICAL=false
# DI(データ入力)をつなぐ物理的な角: 0=左上 1=右上 2=左下 3=右下
MATRIX_START_CORNER=2

# --- 複数パネル構成（拠点ごとに1枚のマトリクスを直列接続する場合）---
# 拠点名:先頭インデックス をカンマ区切りで指定
# LED_PANELS=kanazawa:0,osaka:256

NUXT_PUBLIC_WORKER_URL=http://localhost:8787

# 構成A（ / ページ）: ブラウザがカメラのJPEGを送る先 = analyzer/main.py
NUXT_PUBLIC_ANALYZER_WS_URL=ws://localhost:8765

# 構成C（ /view ページ）: 色を受信するだけの接続先 = ColorHub
# カメラ・解析・LEDはPython（capture_pi.py）が担当し、ブラウザは描画のみ
# ※ HTTPS配信（Cloudflare Pages）から接続する場合は wss:// が必須
NUXT_PUBLIC_COLORHUB_WS_URL=wss://color-vision-worker.color-vision.workers.dev/ws

# Worker APIの認証トークン（AUTH_SECRETと同じ値）
NUXT_PUBLIC_AUTH_TOKEN=
